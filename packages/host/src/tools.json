[
  {
    "name": "inspect_host_shell",
    "description": "Inspect shell defaults and commands shared across activities.",
    "parameters": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "description": "Select one command; omit to list current commands."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Position in the matching command list."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "run_host_shell",
    "description": "Run a command in a fresh shell. Short text appears inline. Partial or binary output includes a log path. A command still running after the initial wait returns a handle and schedules a completion callback for this focus.",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "Host path or local file URI. The startup directory is the default and the base for relative paths."
        },
        "shell": {
          "type": "string",
          "minLength": 1,
          "default": "/bin/sh",
          "description": "Shell executable accepting -c, as a path or local file URI."
        },
        "login": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "batch",
            "pipe",
            "terminal"
          ],
          "default": "batch",
          "description": "batch closes stdin; pipe accepts input; terminal merges stdout/stderr and can alter bytes."
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Omit for no execution deadline."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 16384,
          "default": 4096,
          "description": "Combined byte budget for JSON-encoded stdout and stderr previews."
        },
        "yield_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 10000,
          "description": "Initial wait for completion; zero returns immediately."
        }
      },
      "required": [
        "name",
        "command"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "continue_host_shell",
    "description": "Read output or interact with a command by its handle. Activities share one read position per stream, starting at byte zero. Initial previews and callbacks leave those positions in place. Draining a finished command retires its handle.",
    "parameters": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "object",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "read": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "read"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "write": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "eof": {
                      "type": "boolean",
                      "default": false,
                      "description": "Close pipe stdin after this text, or send Ctrl-D to a terminal without closing its input."
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "One pending write per command."
                }
              },
              "required": [
                "write"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "signal": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": [
                        "interrupt",
                        "terminate",
                        "kill"
                      ],
                      "description": "Interrupt reaches the terminal foreground group; terminate and kill reach its original session. Without a terminal, signals reach the command's process group."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "signal"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "resize": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "cols": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "rows",
                    "cols"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "resize"
              ],
              "additionalProperties": false
            }
          ],
          "default": {
            "read": {}
          },
          "description": "Apply input or control before observing output, even while another call waits."
        },
        "yield_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1000,
          "description": "Wait for unread output or completion; zero returns the current state."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 16384,
          "default": 4096,
          "description": "Combined byte budget for JSON-encoded stdout and stderr previews."
        }
      },
      "required": [
        "command_id"
      ],
      "additionalProperties": false
    }
  }
]
