# Container CLI for dev/memory/start.sh; the mail examples use podman compose.
CONTAINER_ENGINE=podman

# Required model API key. Omitted LLM_BASE_URL and LLM_MODEL use DeepSeek defaults.
LLM_API_KEY=

# Kernel mailbox: keep these credentials aligned with dev/mail/provision.ndjson.
# MAIL_AUTHORIZATION can supply a complete HTTP Authorization value instead.
MAIL_SESSION_URL=http://127.0.0.1:8088/jmap/session
MAIL_ADDRESS=ivenna@ivenna.test
MAIL_USERNAME=ivenna@ivenna.test
MAIL_PASSWORD=ivenna-local-password
MAIL_POLL_INTERVAL_MS=2000

# Operator credentials for the submission examples; keep them aligned with the plan.
OPERATOR_MAIL_ADDRESS=operator@ivenna.test
OPERATOR_MAIL_PASSWORD=operator-local-password

# Concurrent work sessions; the core has a separate coordination lane.
MAX_PARALLEL_ATTENTION=4
# Retained contexts, including the core and waiting parents; independent of work slots.
MAX_ATTENTION_CONTEXTS=32

# Whole serialized request byte limits: CONTEXT_COMPACTION_BYTES >= CONTEXT_REQUEST_BYTES.
CONTEXT_REQUEST_BYTES=65536
CONTEXT_COMPACTION_BYTES=131072
# Handover text bytes and generated response tokens are separate bounds.
HANDOVER_MAX_BYTES=8192
LLM_MAX_OUTPUT_TOKENS=8192

# Kernel artifacts: host output, captured input text, and decoded mail details.
# Relative to the startup directory, or an absolute path.
DATA_DIR=.ivenna

# Local SSH config generated under the repository's .ivenna/; independent of DATA_DIR.
# For normal SSH configuration, remove this setting and unset its exported value.
MEMORY_SSH_CONFIG=.ivenna/dev-memory/config
# Applied when creating the memory container; recreate it after capacity changes.
MEMORY_CAPACITY_BYTES=1073741824
