# Local container engine executable or wrapper used by the startup commands.
CONTAINER_ENGINE=

# DeepSeek API key used by the application.
LLM_API_KEY=

# Local runtime data, relative to the service startup directory or absolute.
DATA_DIR=.ivenna

# SSH connection file generated by dev/memory/start.sh up for local memory.
MEMORY_SSH_CONFIG=.ivenna/dev-memory/config

# Shared memory-room capacity in bytes (default: 1 GiB).
# Applied when dev/memory/start.sh creates the local memory container.
MEMORY_CAPACITY_BYTES=1073741824
