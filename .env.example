# Copy to .env and load it as described in dev/README.md#configuration.
# Kernel settings: docs/running.md#configuration.
# Local service settings: dev/README.md#service-settings.

# Model service API key.
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8192
# Ordinary inference effort by session role; handovers use high effort.
LLM_CORE_REASONING_EFFORT=low
LLM_BRANCH_REASONING_EFFORT=high

# Health/readiness listener. Keep the URL in the private mail plan aligned.
SERVICE_ADDRESS=0.0.0.0:8090

# Dedicated kernel account. Keep credentials aligned with dev/mail/provision.ndjson.
# MAIL_AUTHORIZATION can supply a complete HTTP Authorization value instead.
MAIL_SESSION_URL=http://127.0.0.1:8088/jmap/session
MAIL_ADDRESS=ivenna@ivenna.test
MAIL_USERNAME=ivenna@ivenna.test
MAIL_PASSWORD=ivenna-local-password
MAIL_POLL_INTERVAL_MS=2000

# Local memory SSH config generated by dev/memory/prepare.sh.
# For another workspace, see docs/running.md#memory-service.
MEMORY_SSH_CONFIG=.ivenna/dev-memory/config

# Concurrent work sessions; the core has a separate coordination lane.
MAX_PARALLEL_ATTENTION=4
# Retained contexts, including the core.
MAX_ATTENTION_CONTEXTS=32

# Whole serialized request byte limits.
CONTEXT_REQUEST_BYTES=65536
CONTEXT_COMPACTION_BYTES=131072
# Maximum handover text in bytes.
HANDOVER_MAX_BYTES=8192

# Base directory for host command output; working history stays in the mailbox.
# Relative to the startup directory, or an absolute path.
DATA_DIR=.ivenna

# Correspondent in the MAIL_ADDRESS domain. Keep credentials aligned with the mail plan.
OPERATOR_MAIL_ADDRESS=operator@ivenna.test
OPERATOR_MAIL_PASSWORD=operator-local-password

# Local memory capacity; reload configuration and recreate the service after changes.
MEMORY_CAPACITY_BYTES=1073741824
