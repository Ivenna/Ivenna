# PostgreSQL (compose.yaml). Passwords are applied when creating new login roles.
POSTGRES_PASSWORD=ivenna
POSTGRES_PORT=5432
MEMORY_DATABASE_PASSWORD=ivenna_memory

# Local HTTP service (apps/server). Match each URL to its PostgreSQL database.
DATABASE_URL=postgres://ivenna:ivenna@127.0.0.1:5432/ivenna
MEMORY_DATABASE_URL=postgres://ivenna_memory:ivenna_memory@127.0.0.1:5432/ivenna_memory
HOST=127.0.0.1
PORT=5882

# DeepSeek Responses API. Fill in LLM_API_KEY before starting the service.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
