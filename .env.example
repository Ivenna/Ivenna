# Export DEV_INSTANCE_DIR before loading the instance's .env.
# See dev/README.md for local setup and docs/running.md for kernel settings.

# Model service API key.
LLM_API_KEY=
# Output tokens per response, including reasoning.
LLM_MAX_OUTPUT_TOKENS=65536
# Milliseconds per inference attempt or per file upload, including upload negotiation.
LLM_REQUEST_TIMEOUT_MS=600000
# Ordinary inference effort by session role; handovers use high effort.
LLM_CORE_REASONING_EFFORT=low
LLM_ACTIVITY_REASONING_EFFORT=high

# Optional web page retrieval through DeepSeek Fetch. See docs/running.md#web-page-access.
# DEEPSEEK_API_KEY=

# Health/readiness listener. Keep the URL in the private mail plan aligned.
SERVICE_ADDRESS=0.0.0.0:8090

# Dedicated kernel account. Keep credentials aligned with $DEV_INSTANCE_DIR/mail/provision.ndjson.
# MAIL_AUTHORIZATION can supply a complete HTTP Authorization value instead.
MAIL_SESSION_URL=http://127.0.0.1:8088/jmap/session
MAIL_ADDRESS=ivenna@ivenna.test
MAIL_USERNAME=ivenna@ivenna.test
MAIL_PASSWORD=ivenna-local-password
# Delay between checks for mail and subscription reports, in milliseconds.
MAIL_POLL_INTERVAL_MS=2000

# Account used by the local SMTP example.
OPERATOR_MAIL_ADDRESS=operator@ivenna.test
OPERATOR_MAIL_PASSWORD=operator-local-password
# Comma-separated list of outgoing mailboxes in the MAIL_ADDRESS domain.
MAIL_CORRESPONDENTS="$OPERATOR_MAIL_ADDRESS"

# Local memory SSH config generated by dev/memory/prepare.sh.
# For another memory service, see docs/running.md#memory-service.
MEMORY_SSH_CONFIG="$DEV_INSTANCE_DIR/memory/config"

# Stable session identities, including dormant sessions and the core.
MAX_SESSIONS=128
# Per-session buffer for correspondence, callbacks, assignments, and focus messages.
MAX_PENDING_EVENTS=64
# Live host commands, including commands still in their first tool call.
MAX_HOST_COMMANDS=8

# Compaction threshold for the last ordinary request's input-token count.
CONTEXT_COMPACT_AT_TOKENS=262144
# Encoded request byte threshold for compaction when the input token count is unavailable.
CONTEXT_COMPACT_AT_BYTES=1048576
# Target for the encoded bytes added by a batch of new observations.
CONTEXT_OBSERVATION_BATCH_BYTES=1048576

# Directory for the instance database and host command output.
DATA_DIR="$DEV_INSTANCE_DIR/data"

# Local memory capacity; reload configuration and recreate the service after changes.
MEMORY_CAPACITY_BYTES=1073741824
