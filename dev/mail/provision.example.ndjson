{"@type":"upsert","object":"Domain","matchOn":["name"],"value":{"local-domain":{"name":"ivenna.test","certificateManagement":{"@type":"Manual"},"dkimManagement":{"@type":"Manual"},"dnsManagement":{"@type":"Manual"},"subAddressing":{"@type":"Disabled"}}}}
{"@type":"update","object":"SystemSettings","value":{"defaultHostname":"mail.ivenna.test","defaultDomainId":"#local-domain"}}
{"@type":"update","object":"DataRetention","value":{"expungeTrashAfter":2592000000}}
{"@type":"reconcile","object":"NetworkListener","matchOn":["name"],"value":{"http":{"name":"local-jmap","protocol":"http","bind":{"0.0.0.0:8080":true},"implicitTls":false,"useTls":false},"smtp":{"name":"local-submission","protocol":"smtp","bind":{"0.0.0.0:2525":true},"implicitTls":false,"useTls":false}}}
{"@type":"update","object":"MtaStageAuth","value":{"require":{"else":"true"},"saslMechanisms":{"else":"[plain, login]"},"mustMatchSender":{"else":"true"}}}
{"@type":"upsert","object":"SieveSystemScript","matchOn":["name"],"value":{"ivenna-sender":{"name":"ivenna-sender","isActive":true,"contents":"require [\"variables\", \"envelope\", \"reject\", \"relational\", \"comparator-i;ascii-numeric\"];\nif anyof (\n    not address :count \"eq\" :comparator \"i;ascii-numeric\" \"from\" \"1\",\n    not address :all :comparator \"i;ascii-casemap\" :is \"from\" \"${envelope.from}\"\n) {\n    reject \"550 5.7.1 Use one From address matching the envelope sender.\";\n}"}}}
{"@type":"update","object":"MtaStageData","value":{"script":{"else":"'ivenna-sender'"}}}
{"@type":"upsert","object":"SieveSystemScript","matchOn":["name"],"value":{"ivenna-ready":{"name":"ivenna-ready","isActive":true,"contents":"require [\"envelope\", \"reject\", \"vnd.stalwart.expressions\"];\nif envelope :is \"to\" \"ivenna@ivenna.test\" {\n    if eval \"http_header('http://host.containers.internal:8090/readyz', 'X-Ivenna-Ready', 'Ivenna mail gateway', '2000') != 'true'\" {\n        reject \"550 5.7.1 Ivenna is not accepting messages.\";\n    }\n}"}}}
{"@type":"update","object":"MtaStageRcpt","value":{"script":{"else":"'ivenna-ready'"}}}
{"@type":"upsert","object":"MtaInboundThrottle","matchOn":["description"],"value":{"recipient-throttle":{"description":"Sender address to recipient throttle","enable":false,"key":{"senderDomain":true,"rcpt":true},"rate":{"count":25,"period":3600000}}}}
{"@type":"update","object":"SpamSettings","value":{"enable":false}}
{"@type":"upsert","object":"Tracer","matchOn":["@type"],"value":{"console":{"@type":"Stdout","level":"info","ansi":false}}}
{"@type":"upsert","object":"Account","matchOn":["name","domainId"],"value":{"admin":{"@type":"User","name":"admin","domainId":"#local-domain","roles":{"@type":"Admin"},"credentials":{"0":{"@type":"Password","secret":"admin-local-password"}}},"ivenna":{"@type":"User","name":"ivenna","domainId":"#local-domain","roles":{"@type":"User"},"credentials":{"0":{"@type":"Password","secret":"ivenna-local-password"}}},"operator":{"@type":"User","name":"operator","domainId":"#local-domain","roles":{"@type":"User"},"credentials":{"0":{"@type":"Password","secret":"operator-local-password"}}}}}
